{"id": "image-count", "messages": [{"role": "user", "content": [{"type": "image_url", "image_url": {"url": "data:image/png;base64,"}}, {"type": "text", "text": "How many circles are in this image? Answer with the number only."}]}], "expect": {"regex": "\\b3\\b|\\bthree\\b"}}
