+    def _swiglu(self, gate: Float32, up: Float32, rw: Float32) -> Float32:
+        """Router-weighted SiLU(gate) * up, with the optional SwiGLU clamp."""
+        if cutlass.const_expr(self.has_swiglu_limit):
+            limit = Float32(self.swiglu_limit)
+            neg_limit = Float32(-self.swiglu_limit)
+            if gate > limit:
+                gate = limit
+            if up > limit:
